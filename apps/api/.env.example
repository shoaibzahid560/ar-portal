# Copy to .env for local development. Never commit .env.

# local | preview | staging | production
APP_ENV=local

# Supabase dev project (ar-portal-dev): click Connect, choose Session pooler, and paste the
# string as shown, with [YOUR-PASSWORD] (brackets included) replaced by the database password.
DATABASE_URL=

# The address you open in the browser. Google returns people to <WEB_ORIGIN>/api/auth/google/callback.
WEB_ORIGIN=http://localhost:3000

# Google sign-in: Google Cloud Console > APIs & Services > Credentials > your OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Company Google Workspace domain, e.g. hiredbillingsupport.com. Only people with an account on this
# domain can sign in. May be left empty for local testing only; required everywhere else.
ALLOWED_GOOGLE_DOMAIN=

# The AR team's time zone. "Today" for follow-ups and aging uses this date. Optional.
BUSINESS_TIMEZONE=Asia/Karachi

# Uploaded sheets and EOBs are kept in this folder during local development (never committed). Optional.
LOCAL_STORAGE_DIR=.storage

# ---- Deployed copies (Vercel) ----
# Vercel has no permanent disk: deployed copies keep files in a private Supabase Storage bucket.
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<legacy service_role key; server only, never in the web app>
# STORAGE_BUCKET=ar-portal-files
# A demo copy with fake data may use ALLOWED_GOOGLE_DOMAIN=* (any registered Google account).
# Production must use the company domain.

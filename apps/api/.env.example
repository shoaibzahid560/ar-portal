# Copy to .env for local development. Never commit .env.

# local | preview | staging | production
APP_ENV=local

# Database. Leave commented out to run the API without one.
# After `npx supabase start` (from the project root), uncomment this line for the local database.
# Staging and production use the Supabase transaction pooler URL, with the scheme
# changed from postgresql:// to postgresql+asyncpg://
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

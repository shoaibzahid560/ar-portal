# Copy to .env for local development. Never commit .env.

# local | preview | staging | production
APP_ENV=local

# Supabase dev project (ar-portal-dev): click Connect, choose Session pooler, and paste the
# string as shown, with [YOUR-PASSWORD] (brackets included) replaced by the database password.
DATABASE_URL=

# The address you open in the browser. Google returns people to <WEB_ORIGIN>/api/auth/google/callback.
WEB_ORIGIN=http://localhost:3000

# Google sign-in: Google Cloud Console > APIs & Services > Credentials > your OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Company Google Workspace domain, e.g. hiredbillingsupport.com. Only people with an account on this
# domain can sign in. May be left empty for local testing only; required everywhere else.
ALLOWED_GOOGLE_DOMAIN=
